# =====================================================
# 08-IITP-DABT-PreProcessing 환경 설정 예시
# 이 파일을 .env 로 복사 후 값을 채워 주세요.
#   cp .env.example .env
# =====================================================

# ---------------------------------------------------------
# [DB 연결 설정]
# ---------------------------------------------------------
# 필수 | PostgreSQL 접속 URL
# 형식: postgresql://user:password@host:port/dbname
DB_URL=postgresql://username:password@localhost:5432/iitp_dabt

# 선택 | DB 배치 삽입 크기 (기본값: 100)
DB_BATCH_SIZE=100

# ---------------------------------------------------------
# [로깅 설정]
# ---------------------------------------------------------
# 선택 | 로그 출력 레벨 (DEBUG / INFO / WARNING / ERROR)
# 기본값: INFO
LOG_LEVEL=INFO

# ---------------------------------------------------------
# [외부 시스템 / KOSIS API 설정]
# ---------------------------------------------------------
# 선택 | 수집 대상 외부 시스템 식별자 (이슈 #29, v1.5.0~)
# CLI --ext-sys 가 지정되면 그 값이 우선. 둘 다 없으면 default 'KOSIS'.
# 가능값 예: KOSIS / DATA_GO_KR / MICRODATA (sys_ext_api_info 등록 분만 가능)
EXT_SYS=KOSIS

# ---------------------------------------------------------
# [병렬처리 성능 설정]
# ---------------------------------------------------------
# 선택 | 파일 저장 병렬 워커 수 (기본값: 4)
PARALLEL_WORKERS_FILE=4

# 선택 | DB 삽입 병렬 워커 수 (기본값: 2)
PARALLEL_WORKERS_DB=2

# ---------------------------------------------------------
# [데이터 수집 옵션]
# ---------------------------------------------------------
# 선택 | 데이터 수집 범위 (ALL / PARTIAL, 기본값: ALL)
DATA_COLLECTION_SCOPE=ALL

# ---------------------------------------------------------
# [이동편의 소스 설정] (이슈 #76, v1.7.0~)
# ext_sys: GBIS / KORAIL_CONV / KOWSI_FACL / TOUR_BF_API / GG_TOILET
# 인증키 우선순위: sys_ext_api_info.auth > <EXT_SYS>_API_KEY > DATA_GO_KR_API_KEY
# ---------------------------------------------------------
# 공공데이터포털 공통 인증키 (계정당 1개, 서비스별 활용신청 필요)
DATA_GO_KR_API_KEY=

# GBIS(경기버스정보) — tran_bus_route_info / tran_bus_station_info / tran_bus_route_station 적재
# GBIS_BASE_URL=https://apis.data.go.kr/6410000
# 노선 필터(regionName 부분일치, 기본: 안양)
# GBIS_REGION_FILTER=안양
# 경유정류소(정류장 좌표) 동시 수집 여부 (Issue #85, 기본: true)
# 대상 노선 수만큼 추가 호출이 발생하므로 노선 메타만 갱신할 때는 false
# GBIS_COLLECT_STATIONS=true

# 한국철도공사 편의시설정보 — poi_station_access_status 적재
# KORAIL_CONV_BASE_URL=https://apis.data.go.kr/B551457/convenience
# KORAIL_PAGE_SIZE=500
# 역위치 CSV (Issue #80 좌표 보강, 콤마 구분 복수 경로)
# 소스: 국가철도공단 노선별 역위치 — data.go.kr 15041300(수도권1호선)·15041303(수도권4호선)
# KORAIL_LOC_CSV=ext_data/KRNA_LOC/krna_line1_station_loc.csv,ext_data/KRNA_LOC/krna_line4_station_loc.csv

# 한국사회보장정보원 장애인편의시설 — poi_facility_accessibility 적재
# KOWSI_FACL_BASE_URL=https://apis.data.go.kr/B554287/DisabledPersonConvenientFacility
# KOWSI_ADDR_FILTER=안양시
# KOWSI_PAGE_SIZE=1000 (API 상한 1000 — 초과 시 파라미터 오류)
# 실행당 스캔 페이지 수(일 트래픽 한도 방어, 이어받기는 state.json)
# KOWSI_MAX_PAGES=80
# 전 페이지 완주 후 재스캔 대기 일수
# KOWSI_RESCAN_DAYS=28
# 분할 수집 상태 파일 경로
# KOWSI_STATE_PATH=ext_data/KOWSI_FACL/state.json
# 기구표 상세 호출 여부 — 시설 1건당 1호출이라 트래픽을 많이 쓴다. 코드 기본값 OFF.
#   개발계정(일 100건)에서는 완주 불가. 운영계정 전환 후 ON 으로 둔다.
#   실측 2026-09-04: 안양 1,617개 시설 전수 수집 약 25분(동시 5, 429 없음).
#   OFF 로 두면 접근성 플래그 6종이 전부 NULL 로 남는다.
# KOWSI_FETCH_EVAL=OFF

# 경기데이터드림 공중화장실 현황(제공표준) — poi_public_toilet_info 적재 (2026-09-05)
#   원천 https://openapi.gg.go.kr/Publtolt — 호출 제한 없음, 좌표 제공(행안부 표준데이터는 2025-02부터 좌표 중단)
#   인증키는 경기데이터드림 회원 발급(공공데이터포털 키와 다르다)
# GG_TOILET_API_KEY=
# GG_TOILET_BASE_URL=https://openapi.gg.go.kr/Publtolt
#   주소 접두어 필터(도로명·지번 시작 일치). 빈 값이면 경기도 전체(약 11,217건).
#   적재는 이 접두어와 sido_code 로 잡은 기존 행을 논리삭제(del_yn=Y)한 뒤 전량 다시 넣는다.
# GG_TOILET_ADDR_FILTER=경기도 안양시
# GG_TOILET_PAGE_SIZE=1000 (API 상한 1000)
# GG_TOILET_MAX_PAGES=50

# 한국관광공사 무장애여행 — poi_tour_bf_facility 적재
# TOUR_BF_API_BASE_URL=https://apis.data.go.kr/B551011/KorWithService2
#   목록은 법정동 코드로 조회한다(v1.17.1). 시도 1개 + 시군구 여러 개(쉼표) — 기본: 경기 41, 안양 만안구 171·동안구 173.
#   종전의 TOUR_AREA_CODE·TOUR_SIGUNGU_CODE(옛 지역 코드)는 더 이상 읽지 않는다.
# TOUR_LDONG_REGN_CD=41
# TOUR_LDONG_SIGNGU_CDS=171,173
#   적재 범위(주소 접두어). 이 범위 안의 기존 활성 행 중 이번 수집에 없는 행은 논리삭제한다.
#   수집 건수가 기존 활성 행의 절반 미만이면 원천 장애로 보고 삭제하지 않는다.
# TOUR_BF_ADDR_FILTER=경기도 안양시

# ---------------------------------------------------------
# [수집 이상 알림 메일] (v1.17.0)
# 정기 실행(db 모드·전체 범위)이 실패하면, 그리고 실패 뒤 다시 성공하면 메일을 보낸다.
# 수신 주소·사용 여부는 DB(sys_ops_setting)에 있고 운영 콘솔 [운영] 탭에서 바꾼다.
# 실행 기록은 DB(sys_batch_run_log)에 남는다. 설정이 없으면 기록만 하고 메일은 보내지 않는다.
# ---------------------------------------------------------
# 발신 방식: mx | graph | smtp (비우면 MAIL_MX_HOST → mx, GRAPH_* → graph, 그 외 smtp)
# MAIL_BACKEND=mx
# 메일에 표시할 발신자 이름
# MAIL_FROM_NAME=IITP 데이터 수집 알림
# 메일 본문에 넣을 운영 콘솔 주소(선택)
# OPS_CONSOLE_URL=

# [mx] 수신 도메인의 메일 서버(MX 레코드 값)에 직접 건넨다 — 계정·비밀번호 불필요, 포트 25 사용.
#      수신 주소는 그 메일 서버가 받는 도메인이어야 한다. 첫 메일이 정크로 가면 "정크 아님"으로 표시한다.
# MAIL_MX_HOST=<수신도메인의 MX 호스트>
# MAIL_FROM=noreply@<발신 표시 도메인>
# MAIL_HELO=<발신 표시 도메인>

# [graph] Microsoft 365 — Entra ID 앱(애플리케이션 권한 Mail.Send)으로 Graph sendMail 호출
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SENDER=<발신 메일함 주소>

# [smtp] 일반 SMTP 서버 (587=STARTTLS, 465=SSL)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ---------------------------------------------------------
# [KOSIS 통계표 구조 변경 수동 허용] (v1.17.0) — .env 에 넣지 말 것
# 원천의 분류 체계 변경을 확인한 뒤 "이번 한 번은 바뀐 대로 적재"할 때 명령줄에만 붙인다.
#   KOSIS_ACCEPT_RESHAPE=DT_xxx python main.py --mode db
# ---------------------------------------------------------
